{% extends "dashboard.jinja2" %}

{% block title %}Servers | Broke{% endblock %}

{% block head %}
    <link rel="stylesheet" href="{{ url_for('static', filename='css/settings.css') }}">
    <link rel="stylesheet" href="{{ url_for('static', filename='css/metrics.css') }}">
{% endblock %}

{% block path %}
    <span><i class="ph ph-hard-drives"></i> Servers</span>
{% endblock %}

{% block content %}
<div class="met-page-header">
    <div>
        <h1>Servers</h1>
        <p class="card-description">
            {% if rows %}{{ online_count }} of {{ rows|length }} reporting{% else %}Metrics pushed by Telegraf{% endif %}
        </p>
    </div>
</div>

{% if not rows %}
<div class="met-empty">
    <p>No servers are reporting yet.</p>
    <p>Create a metrics token under <a href="{{ request.script_root }}/settings/metrics">Settings &rsaquo; Metrics</a>,
       then point Telegraf's <code>outputs.influxdb_v2</code> at this instance.</p>
    <pre class="met-config">[[outputs.influxdb_v2]]
  urls = ["{{ request.url_root.rstrip('/') }}"]
  token = "&lt;your metrics token&gt;"
  organization = "broke"
  bucket = "broke"</pre>
</div>
{% else %}
<div class="met-board" id="met-board">
    {% for row in rows %}
    <a class="met-row {% if not row.online %}is-offline{% endif %}"
       href="{{ request.script_root }}/servers/{{ row.hostname | urlencode }}"
       data-host="{{ row.hostname | e }}">
        <span class="met-status met-status-{{ 'up' if row.online else 'stale' }}" data-field="status">
            {{ 'Online' if row.online else 'Stale' }}
        </span>
        <div class="met-identity">
            <span class="met-name">{{ row.hostname | e }}</span>
            <div class="met-meta" data-field="last-seen">Last report {{ row.last_seen_display }}</div>
        </div>
        <div class="met-gauges">
            {% for gauge in [('CPU', row.cpu, 'cpu'), ('Memory', row.memory, 'memory'), ('Disk', row.disk, 'disk')] %}
            <div class="met-gauge" data-gauge="{{ gauge[2] }}">
                <span class="met-gauge-label">{{ gauge[0] }}</span>
                <span class="met-gauge-track">
                    <span class="met-gauge-fill" style="width: {{ '%.1f'|format(gauge[1]) if gauge[1] is not none else 0 }}%;"
                          data-level="{{ 'high' if gauge[1] is not none and gauge[1] >= 90 else ('warn' if gauge[1] is not none and gauge[1] >= 75 else 'ok') }}"></span>
                </span>
                <span class="met-gauge-value">{% if gauge[1] is not none %}{{ '%.0f'|format(gauge[1]) }}%{% else %}—{% endif %}</span>
            </div>
            {% endfor %}
        </div>
        <div class="met-stats">
            <span class="met-stats-primary" data-field="load">
                {% if row.load1 is not none %}{{ '%.2f'|format(row.load1) }}{% else %}—{% endif %}
            </span>
            <span class="met-stats-secondary">load 1m</span>
        </div>
    </a>
    {% endfor %}
</div>
{% endif %}

<script>
(function () {
    function pct(v) { return v == null ? '—' : Math.round(v) + '%'; }
    function level(v) {
        if (v == null) return 'ok';
        if (v >= 90) return 'high';
        if (v >= 75) return 'warn';
        return 'ok';
    }

    function apply(hosts) {
        var byName = {};
        hosts.forEach(function (h) { byName[h.hostname] = h; });
        document.querySelectorAll('#met-board .met-row').forEach(function (row) {
            var h = byName[row.getAttribute('data-host')];
            if (!h) return;

            var status = row.querySelector('[data-field="status"]');
            if (status) {
                status.className = 'met-status met-status-' + (h.online ? 'up' : 'stale');
                status.textContent = h.online ? 'Online' : 'Stale';
            }
            row.classList.toggle('is-offline', !h.online);

            var seen = row.querySelector('[data-field="last-seen"]');
            if (seen) seen.textContent = 'Last report ' + h.last_seen_display;

            [['cpu', h.cpu], ['memory', h.memory], ['disk', h.disk]].forEach(function (pair) {
                var gauge = row.querySelector('[data-gauge="' + pair[0] + '"]');
                if (!gauge) return;
                var fill = gauge.querySelector('.met-gauge-fill');
                var value = gauge.querySelector('.met-gauge-value');
                if (fill) {
                    fill.style.width = (pair[1] == null ? 0 : Math.max(0, Math.min(100, pair[1]))) + '%';
                    fill.setAttribute('data-level', level(pair[1]));
                }
                if (value) value.textContent = pct(pair[1]);
            });

            var load = row.querySelector('[data-field="load"]');
            if (load) load.textContent = h.load1 == null ? '—' : Number(h.load1).toFixed(2);
        });
    }

    async function poll() {
        try {
            const r = await fetch(brokeAppUrl('/api/metrics/hosts'), {
                credentials: 'same-origin',
                headers: { 'Accept': 'application/json' }
            });
            if (!r.ok) return;
            const data = await r.json();
            if (data.hosts) apply(data.hosts);
        } catch (_) { /* ignore */ }
    }

    if (document.getElementById('met-board')) {
        setInterval(poll, 15000);
    }
})();
</script>
{% endblock %}
