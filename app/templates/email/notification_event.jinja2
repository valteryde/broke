{% extends "email/base.jinja2" %}
{% block email_title %}{{ headline }} · Broke{% endblock %}
{% block preheader %}{{ preheader }}{% endblock %}
{% block content %}
<table role="presentation" width="100%" cellspacing="0" cellpadding="0" style="border-collapse:collapse;margin:0 0 20px;">
  <tr>
    <td style="border-left: 4px solid {{ accent }};padding: 0 0 0 16px;">
      <h1 style="margin:0 0 6px;font-family: {{ brand.heading_font }};font-size: 20px;font-weight: 600;color: #111827;line-height: 1.25;">
        {{ headline }}
      </h1>
      {% if title %}
      <p style="margin:0;font-family: {{ brand.body_font }};font-size: 17px;font-weight: 500;color: #1f2937;line-height: 1.35;">
        {{ title }}
      </p>
      {% endif %}
    </td>
  </tr>
</table>
{% if fields %}
<table role="presentation" width="100%" cellspacing="0" cellpadding="0" style="border-collapse:collapse;background-color: #fafafa;border: 1px dashed #9ca3af;border-radius: 10px;">
  {% for label, value in fields %}
  <tr>
    <td style="padding: 14px 16px;font-family: {{ brand.body_font }};font-size: 14px;{% if not loop.last or body_html %}border-bottom: 1px solid {{ brand.bg_light_gray }};{% endif %}">
      <span style="display:block;font-size: 11px;font-weight: 600;letter-spacing: 0.04em;text-transform: uppercase;color: {{ brand.secondary }};">{{ label }}</span>
      <span style="color: #111827;white-space: pre-wrap;word-break: break-word;">{{ value }}</span>
    </td>
  </tr>
  {% endfor %}
</table>
{% endif %}
{% if body_html %}
<table role="presentation" width="100%" cellspacing="0" cellpadding="0" style="border-collapse:collapse;margin:{% if fields %}16px{% else %}0{% endif %} 0 0;background-color: #fafafa;border: 1px dashed #9ca3af;border-radius: 10px;">
  <tr>
    <td style="padding: 14px 16px;font-family: {{ brand.body_font }};font-size: 14px;line-height: 1.55;color: #111827;">
      {% if body_label %}
      <span style="display:block;margin:0 0 8px;font-size: 11px;font-weight: 600;letter-spacing: 0.04em;text-transform: uppercase;color: {{ brand.secondary }};">{{ body_label }}</span>
      {% endif %}
      {{ body_html | safe }}
    </td>
  </tr>
</table>
{% endif %}
{% if cta_url %}
<p style="margin:20px 0 0;font-family: {{ brand.body_font }};font-size: 15px;">
  <a href="{{ cta_url }}" style="color: {{ brand.logo_blue }};font-weight: 600;text-decoration: none;">{{ cta_label or 'Open in Broke →' }}</a>
</p>
{% endif %}
{% endblock %}
