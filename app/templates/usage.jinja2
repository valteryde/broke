{% extends "dashboard.jinja2" %}

{% block title %}Usage | Broke{% endblock %}

{% block head %}
    <link rel="stylesheet" href="{{ url_for('static', filename='css/vendor/uplot-1.6.32.min.css') }}">
    <link rel="stylesheet" href="{{ url_for('static', filename='css/usage.css') }}">
{% endblock %}

{% block path %}
    <span><i class="ph ph-chart-line-up"></i> Usage</span>
{% endblock %}

{% block content %}
<div
    class="use-page"
    id="usage-page"
    data-range="{{ range_key }}"
    data-snippet="{{ snippet_url }}"
    data-settings="{{ request.script_root }}{{ settings_url }}"
    data-has-key="{{ '1' if has_site_key else '0' }}"
    data-map-src="{{ url_for('static', filename='js/vendor/world-110m.json') }}"
>
    <div class="use-header">
        <div>
            <h1>Usage</h1>
            <p>How people move through the product</p>
        </div>
        <div class="use-ranges">
            {% for key in ranges %}
            <a href="{{ request.script_root }}/usage?range={{ key }}" data-range="{{ key }}" class="{% if key == range_key %}is-active{% endif %}">{{ range_labels.get(key, key) }}</a>
            {% endfor %}
        </div>
    </div>

    <div id="usage-body">
        <div class="use-empty">
            <i class="ph ph-chart-line-up"></i>
            <p>Loading usage…</p>
        </div>
    </div>
</div>
{% endblock %}

{% block scripts %}
    <script src="{{ url_for('static', filename='js/vendor/uplot-1.6.32.min.js') }}"></script>
    <script src="{{ url_for('static', filename='js/usage.js') }}"></script>
{% endblock %}
