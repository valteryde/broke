{% extends "standalone.jinja2" %}

{% block head %}
    <meta name="description" content="Submit an anonymous ticket to {{ site_name }}.">
    <script src="{{ url_for('static', filename='js/config.js') }}"></script>
    <link rel="stylesheet" href="{{ url_for('static', filename='css/anon.css') }}">
{% endblock %}

{% block title %}Submit Anonymous Ticket - {{ site_name }}{% endblock %}

{% block content %}
<div class="anon-container anon-flow">
    <div class="anon-card">
        {% if welcome_message %}
            <p class="anon-welcome">{{ welcome_message }}</p>
        {% endif %}

        <section id="anon-kind-step">
            <h1 class="anon-title">What are you sending?</h1>
            <div class="anon-kind-list">
                <button type="button" class="anon-kind" data-kind="problem">
                    <i class="ph ph-warning" aria-hidden="true"></i>
                    <span>
                        <strong>Problem</strong>
                        <small>Something is broken</small>
                    </span>
                </button>
                <button type="button" class="anon-kind" data-kind="feature">
                    <i class="ph ph-lightbulb" aria-hidden="true"></i>
                    <span>
                        <strong>Feature</strong>
                        <small>Something new</small>
                    </span>
                </button>
                <button type="button" class="anon-kind" data-kind="improvement">
                    <i class="ph ph-wrench" aria-hidden="true"></i>
                    <span>
                        <strong>Improvement</strong>
                        <small>Something that should work better</small>
                    </span>
                </button>
            </div>
        </section>

        <section id="anon-detail-step" hidden>
            <button type="button" class="anon-back" id="anon-back"><i class="ph ph-arrow-left" aria-hidden="true"></i> Back</button>
            <form id="anon-form" class="anon-form">
                <div id="anon-fields"></div>

                <div class="anon-name">
                    <div class="anon-question-line">
                        <button type="button" class="anon-error-arrow" data-for="title" hidden></button>
                        <label id="anon-title-label" for="answer-title">What should we call this?</label>
                    </div>
                    <input type="text" id="answer-title" maxlength="140" autocomplete="off">
                    <p class="anon-field-note" data-for="title" hidden></p>
                </div>

                <div class="anon-reply">
                    <label for="primary-email"><i class="ph ph-envelope" aria-hidden="true"></i> Where should we reply?</label>
                    <input type="email" id="primary-email" autocomplete="email" placeholder="you@example.com">
                </div>

                <div class="anon-tools">
                    <button type="button" class="anon-quiet" id="anon-add-image" aria-expanded="false" aria-controls="anon-image-panel">
                        <i class="ph ph-image" aria-hidden="true"></i>
                        Add a picture
                    </button>
                    <div id="anon-image-panel" class="anon-panel" hidden>
                        <input type="file" id="anon-image" accept="image/png,image/jpeg,image/webp,image/gif">
                        <span id="anon-image-name" class="anon-file-name"></span>
                        <p class="anon-field-note" data-for="image" hidden></p>
                    </div>

                    <button type="button" class="anon-quiet" id="anon-add-copies" aria-expanded="false" aria-controls="anon-copies-panel">
                        <i class="ph ph-users" aria-hidden="true"></i>
                        Also notify someone
                    </button>
                    <div id="anon-copies-panel" class="anon-panel" hidden>
                        <label for="copy-emails">Other emails, one per line, up to five</label>
                        <textarea id="copy-emails" rows="2" placeholder="one address per line"></textarea>
                    </div>
                </div>

                <p id="anon-review-reading" class="anon-review-reading" hidden>Reading your report</p>
                <section id="anon-report" class="anon-report" hidden>
                    <p id="anon-review-headline" class="anon-review-headline"></p>
                    <ul id="anon-review-list" class="anon-review-list"></ul>
                </section>
                <p id="anon-form-error" class="anon-form-error" hidden></p>

                <div class="form-actions">
                    <button type="submit" class="btn btn-primary anon-send" id="anon-submit">
                        <i class="ph ph-paper-plane-tilt" aria-hidden="true"></i>
                        Send
                    </button>
                </div>
            </form>
        </section>

        <section id="anon-check-step" class="anon-check" hidden>
            <i class="ph ph-envelope anon-check-icon" aria-hidden="true"></i>
            <h2 class="anon-title">Check your email</h2>
            <p class="anon-subtitle">We sent a confirmation link to <strong id="anon-check-email"></strong>. The report is filed when that link is confirmed. Extra addresses get their own link and do not hold this up.</p>
        </section>
    </div>
</div>

<script id="anon-kind-specs" type="application/json">{{ kind_specs | tojson }}</script>
<script>
    const kindSpecs = JSON.parse(document.getElementById("anon-kind-specs").textContent);
    const saved = {};
    let currentKind = "";
    let reviewToken = "";

    const flow = document.querySelector(".anon-flow");
    const kindStep = document.getElementById("anon-kind-step");
    const detailStep = document.getElementById("anon-detail-step");
    const checkStep = document.getElementById("anon-check-step");
    const fieldsRoot = document.getElementById("anon-fields");
    const titleInput = document.getElementById("answer-title");
    const titleLabel = document.getElementById("anon-title-label");
    const report = document.getElementById("anon-report");
    const headline = document.getElementById("anon-review-headline");
    const reviewList = document.getElementById("anon-review-list");
    const reading = document.getElementById("anon-review-reading");
    const formError = document.getElementById("anon-form-error");

    function specFor(kind) {
        return kindSpecs.find((item) => item.key === kind);
    }

    function answersFromForm() {
        const spec = specFor(currentKind);
        const answers = { kind: currentKind, title: titleInput.value };
        spec.fields.forEach((field) => {
            const input = document.getElementById("answer-" + field.key);
            answers[field.key] = input ? input.value : "";
        });
        return answers;
    }

    function remember() {
        if (!currentKind) return;
        saved[currentKind] = answersFromForm();
    }

    function clearArrows() {
        document.querySelectorAll(".anon-error-arrow").forEach((arrow) => {
            arrow.hidden = true;
            arrow.textContent = "";
        });
    }

    function clearReview() {
        reviewToken = "";
        report.hidden = true;
        headline.textContent = "";
        reviewList.replaceChildren();
        clearArrows();
        flow.classList.remove("has-report");
        document.querySelectorAll(".anon-field-note").forEach((note) => {
            note.hidden = true;
            note.textContent = "";
        });
    }

    function showError(message) {
        formError.hidden = !message;
        formError.textContent = message || "";
        if (message) formError.scrollIntoView({ block: "nearest" });
    }

    function fieldNote(field, message) {
        const note = document.querySelector('.anon-field-note[data-for="' + field + '"]');
        if (!note) return;
        note.hidden = !message;
        note.textContent = message || "";
    }

    function renderChecklist(payload) {
        clearArrows();
        const notes = Array.isArray(payload.notes) ? payload.notes.slice() : [];
        const questionNotes = notes.filter((note) => document.getElementById("answer-" + (note.field || "")));
        const loose = notes.filter((note) => !document.getElementById("answer-" + (note.field || "")));
        if (!questionNotes.length) {
            flow.classList.remove("has-report");
            report.hidden = true;
            headline.textContent = "";
            reviewList.replaceChildren();
            const message = loose.map((note) => note.message).filter(Boolean).join(" ");
            showError(message || payload.headline || "The check did not finish. Try again.");
            return;
        }
        flow.classList.add("has-report");
        report.hidden = false;
        headline.textContent = payload.headline || "";
        reviewList.replaceChildren();
        questionNotes.sort((a, b) => Number(Boolean(a.ok)) - Number(Boolean(b.ok)));
        questionNotes.forEach((note) => {
            const row = document.createElement("li");
            row.className = "anon-review-row";
            row.dataset.ok = note.ok ? "yes" : "no";
            const button = document.createElement("button");
            button.type = "button";
            button.className = "anon-review-row-button";
            const icon = document.createElement("i");
            icon.className = note.ok ? "ph ph-check" : "ph ph-arrow-right";
            icon.setAttribute("aria-hidden", "true");
            const text = document.createElement("span");
            const label = document.createElement("strong");
            label.className = "anon-review-label";
            const input = document.getElementById("answer-" + note.field);
            const inputLabel = input ? document.querySelector('label[for="answer-' + note.field + '"]') : null;
            label.textContent = inputLabel ? inputLabel.textContent.replace("optional", "").trim() : note.field;
            const sentence = document.createElement("span");
            sentence.textContent = note.message || "";
            text.append(label, sentence);
            button.append(icon, text);
            button.addEventListener("click", () => {
                if (input) input.focus();
            });
            row.append(button);
            reviewList.append(row);
            const arrow = document.querySelector('.anon-error-arrow[data-for="' + note.field + '"]');
            if (arrow && !note.ok) {
                arrow.hidden = false;
                arrow.textContent = note.message || "";
                arrow.onclick = () => {
                    if (input) input.focus();
                };
            }
            fieldNote(note.field, note.message || "");
        });
        const firstMiss = questionNotes.find((note) => !note.ok);
        const firstArrow = firstMiss
            ? document.querySelector('.anon-error-arrow[data-for="' + firstMiss.field + '"]')
            : null;
        if (firstArrow) firstArrow.scrollIntoView({ block: "nearest" });
        else if (questionNotes.length) reviewList.scrollIntoView({ block: "nearest" });
    }

    function grow(input) {
        input.style.height = "auto";
        input.style.height = input.scrollHeight + "px";
    }

    function buildFields(kind) {
        const spec = specFor(kind);
        const prior = saved[kind] || {};
        titleLabel.textContent = spec.title_label;
        titleInput.placeholder = spec.title_example || "";
        titleInput.value = prior.title || "";
        fieldsRoot.replaceChildren();
        spec.fields.forEach((field, index) => {
            const group = document.createElement("div");
            group.className = index === 0 ? "anon-story" : "anon-story anon-follow";
            const line = document.createElement("div");
            line.className = "anon-question-line";
            const arrow = document.createElement("button");
            arrow.type = "button";
            arrow.className = "anon-error-arrow";
            arrow.dataset.for = field.key;
            arrow.hidden = true;
            const heading = document.createElement(index === 0 ? "h1" : "h2");
            heading.className = "anon-question";
            const label = document.createElement("label");
            label.htmlFor = "answer-" + field.key;
            label.textContent = field.label;
            heading.append(label);
            line.append(arrow, heading);
            const input = document.createElement("textarea");
            input.id = "answer-" + field.key;
            input.rows = 2;
            input.placeholder = field.example || "";
            input.value = prior[field.key] || "";
            const note = document.createElement("p");
            note.className = "anon-field-note";
            note.dataset.for = field.key;
            note.hidden = true;
            group.append(line, input, note);
            fieldsRoot.append(group);
            input.addEventListener("input", () => {
                grow(input);
                clearReview();
            });
            requestAnimationFrame(() => grow(input));
        });
    }

    function bindToggle(button, panel, focus) {
        button.addEventListener("click", () => {
            const willOpen = panel.hidden;
            panel.hidden = !willOpen;
            button.setAttribute("aria-expanded", String(willOpen));
            if (willOpen && focus) focus.focus();
        });
    }

    document.querySelectorAll(".anon-kind").forEach((button) => {
        button.addEventListener("click", () => {
            remember();
            currentKind = button.dataset.kind;
            buildFields(currentKind);
            clearReview();
            showError("");
            kindStep.hidden = true;
            detailStep.hidden = false;
            checkStep.hidden = true;
        });
    });

    document.getElementById("anon-back").addEventListener("click", () => {
        remember();
        clearReview();
        detailStep.hidden = true;
        kindStep.hidden = false;
    });

    titleInput.addEventListener("input", clearReview);

    bindToggle(
        document.getElementById("anon-add-image"),
        document.getElementById("anon-image-panel"),
        document.getElementById("anon-image")
    );
    bindToggle(
        document.getElementById("anon-add-copies"),
        document.getElementById("anon-copies-panel"),
        document.getElementById("copy-emails")
    );
    document.getElementById("anon-image").addEventListener("change", () => {
        const file = document.getElementById("anon-image").files[0];
        document.getElementById("anon-image-name").textContent = file ? file.name : "";
    });

    document.getElementById("anon-form").addEventListener("submit", async (event) => {
        event.preventDefault();
        showError("");
        const submitButton = document.getElementById("anon-submit");
        const answers = answersFromForm();
        submitButton.disabled = true;
        reading.hidden = false;
        report.hidden = true;
        reviewList.replaceChildren();
        headline.textContent = "";
        clearArrows();
        flow.classList.remove("has-report");

        try {
            const review = await fetch(brokeAppUrl("/api/anon/review"), {
                method: "POST",
                headers: { "Content-Type": "application/json" },
                body: JSON.stringify(answers),
            });
            let verdict;
            try {
                verdict = await review.json();
            } catch (parseError) {
                showError(
                    review.status === 429
                        ? "Too many reports from this network. Try again later."
                        : "The check did not finish. Try again."
                );
                submitButton.disabled = false;
                return;
            }
            reading.hidden = true;
            if (!review.ok) {
                showError(verdict.error || "The check did not finish.");
                submitButton.disabled = false;
                return;
            }
            renderChecklist(verdict);
            if (!verdict.ready) {
                submitButton.disabled = false;
                return;
            }
            reviewToken = verdict.review_token || "";
            const payload = Object.assign({}, answers, {
                review_token: reviewToken,
                primary_email: document.getElementById("primary-email").value,
                copy_emails: document.getElementById("copy-emails").value,
            });
            const file = document.getElementById("anon-image").files[0];
            if (file) {
                if (file.size > 2 * 1024 * 1024) {
                    fieldNote("image", "The image must be 2 MB or smaller.");
                    submitButton.disabled = false;
                    return;
                }
                payload.image = await new Promise((resolve, reject) => {
                    const reader = new FileReader();
                    reader.onload = () => resolve(reader.result);
                    reader.onerror = () => reject(new Error("image"));
                    reader.readAsDataURL(file);
                });
            }
            const submitted = await fetch(brokeAppUrl("/api/anon/submit"), {
                method: "POST",
                headers: { "Content-Type": "application/json" },
                body: JSON.stringify(payload),
            });
            const result = await submitted.json();
            if (!submitted.ok) {
                showError(result.error || "Could not send the report.");
                if (result.field) fieldNote(result.field, result.error);
                submitButton.disabled = false;
                return;
            }
            if (result.track) {
                window.location.assign(brokeAppUrl(result.track));
                return;
            }
            document.getElementById("anon-check-email").textContent = payload.primary_email;
            detailStep.hidden = true;
            checkStep.hidden = false;
        } catch (error) {
            reading.hidden = true;
            showError("The check did not finish. Try again.");
            submitButton.disabled = false;
        }
    });
</script>
{% endblock %}
